  "apply_to": "future-training-entries",
  "automatic_window_resize_or_reposition": false,
  "reason": "User requested discontinuing the choppy native live window. Keep visible training and normal-speed recorded clips without requiring continuous native rendering.",
  "native_viewer_exceptions": []
}
