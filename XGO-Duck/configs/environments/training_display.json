{
  "mode": "recorded-clips-and-progress",
  "native_live_window": false,
  "visible_terminal_required": true,
  "terminal": "existing-shared-vscode-task-terminal",
  "video_enabled": true,
  "video_interval_control_steps": 1200,
  "video_length_control_steps": 200,
  "recording_playback_fps": 50,
  "progress_curves": "saved-raw-training-values",
